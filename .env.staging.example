# Staging environment configuration - prevents quota usage
# Copy to .env.staging and customize

# Enable dry-run mode for Postmark to avoid burning through quota
POSTMARK_DRY_RUN=true
CELLOPHANEMAIL_STAGING_MODE=true

# Optional: Log dry-run emails to file for debugging
POSTMARK_LOG_DRY_RUN=true

# Use local SMTP for staging instead of Postmark
EMAIL_DELIVERY_METHOD=smtp
SMTP_HOST=localhost
SMTP_PORT=1025

# Or use Gmail if you have it configured
# EMAIL_DELIVERY_METHOD=gmail

# Database for staging (docker-compose db on port 5433)
DATABASE_URL=postgresql://cellophane_user:docker_dev_pass_2024@localhost:5433/cellophanemail_staging

# Anthropic key for AI analysis (use cautiously in staging)
# ANTHROPIC_API_KEY=your_key_here

# License key for staging commercial features
# CELLOPHANEMAIL_LICENSE_KEY=COM-STAGING-KEY
